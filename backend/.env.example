# AxrflowsQuotes Backend Environment Configuration Example
# Copy this file to .env and fill in your credentials

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI provider: AIML API (https://aimlapi.com, OpenAI-compatible). Key from aimlapi.com > Key management.
# The model can be changed at any time in Admin > System Settings; AI_MODEL is the default.
AI_API_KEY=your-aimlapi-key
AI_BASE_URL=https://api.aimlapi.com/v1
AI_MODEL=openai/gpt-4o-mini
AI_FALLBACK_MODELS=openai/gpt-4.1-mini
# low | medium | high, only for reasoning models (o-series, gpt-5). Leave empty for gpt-4o / gpt-4.1.
AI_REASONING_EFFORT=

# Server Configuration
PORT=8000
HOST=127.0.0.1
# Also used to build the customer-facing quote links (FRONTEND_URL/q/<token>)
FRONTEND_URL=http://localhost:5173

# Background Gmail IMAP poller (only one process per deployment should poll;
# set to false on additional replicas). Interval in seconds.
ENABLE_EMAIL_POLLER=true
EMAIL_POLL_INTERVAL_SECONDS=30

# Let tenants without their own Gemini/Gmail/Twilio credentials fall back to the
# admin user's credentials. Leave false unless you deliberately share accounts.
ALLOW_ADMIN_CREDENTIAL_FALLBACK=false

# Required to enable POST /api/leads/webhook (sent as the X-Webhook-Token header)
WEBHOOK_SECRET_TOKEN=

# Public URL of this backend as Twilio calls it (needed behind proxies/load
# balancers so X-Twilio-Signature validation uses the right URL)
PUBLIC_BACKEND_URL=

# Optional extra CORS origins, comma-separated
CORS_ORIGINS=

# Knowledge base text sent with each quote request is capped at this many characters;
# above it only the sections most relevant to the request are sent.
KB_CONTEXT_MAX_CHARS=60000

# How often (seconds) the background worker checks for quotes due an automatic follow-up.
# Follow-ups, automatic drafts and webhooks are switched on per workspace in Settings > Automation.
FOLLOW_UP_CHECK_INTERVAL_SECONDS=900

# Mailbox sign-in with Google / Microsoft (replaces app passwords; required for Outlook / Microsoft 365).
# Redirect URIs to register: <PUBLIC_BACKEND_URL>/api/oauth/google/callback and .../api/oauth/microsoft/callback
# Google scopes: https://mail.google.com/ openid email
# Microsoft delegated permissions: IMAP.AccessAsUser.All, SMTP.Send, offline_access, openid, email
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Set to "production" in deployment. The backend then refuses to start while the
# temporary dev admin (admin@admin.com) still exists. See PROJECT_NOTES.md section 12.
ENV=
